BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
# JSON map: { "<channelId>": "wow" | "diablo" | "ff14" }
# Phase 1 can leave this unset — the /zz handler returns the
# friendly "not set up here" message until you populate it.
CHANNEL_GAME_MAP=

# Anthropic API key, starts with sk-ant-. Get one at
# https://console.anthropic.com/. Set a usage cap on the key
# in the console so a runaway bot can't drain the wallet.
ANTHROPIC_API_KEY=
